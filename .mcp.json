{
  "mcpServers": {
    "reagent": {
      "type": "stdio",
      "command": "node",
      "args": [
        "node_modules/@bookedsolid/reagent/dist/cli/index.js",
        "serve"
      ]
    },
    "obsidian": {
      "command": "npx",
      "args": ["-y", "obsidian-mcp"],
      "env": {
        "OBSIDIAN_VAULT_PATH": "/Volumes/Development/booked/data/bst"
      }
    }
  }
}
