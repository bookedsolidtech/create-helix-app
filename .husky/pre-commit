#!/usr/bin/env sh
# .husky/pre-commit — secret + .env scan on staged files before commit
#
# Gates (in order):
#   1. gitleaks protect --staged (REQUIRED — hard fail if not installed)
#   2. .env and .envrc staged file check (always — no gitleaks dependency)
#   3. lint-staged formatters/linters on the staged set
#
# Exit codes:
#   0 = all gates passed
#   1 = gate failed — commit blocked

set -e

# ── Resolve main repo root (handles git worktrees) ───────────────────────────
# In a worktree, --git-common-dir returns an absolute path to the main .git dir.
# In the main repo, it returns the relative string ".git".
GIT_COMMON_DIR=$(git rev-parse --git-common-dir 2>/dev/null)
case "$GIT_COMMON_DIR" in
  /*)
    MAIN_ROOT="$(dirname "$GIT_COMMON_DIR")"
    ;;
  *)
    MAIN_ROOT="$(git rev-parse --show-toplevel)"
    ;;
esac

# ── Gate 1: Secret scanning with gitleaks (REQUIRED) ─────────────────────────
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "ERROR: gitleaks not installed — pre-commit secret scan is mandatory." >&2
  echo "  macOS:  brew install gitleaks" >&2
  echo "  Linux:  download from https://github.com/gitleaks/gitleaks/releases" >&2
  exit 1
fi
gitleaks protect --staged --config "$MAIN_ROOT/.gitleaks.toml" --redact --exit-code 1

# ── Gate 2: .env / .envrc staged file check ──────────────────────────────────
# Check for .env* or .envrc files anywhere in the repo (including subdirectories).
# gitleaks rules catch CONTENT; this gate catches the filename so a blank
# .env staged "to test something" still blocks the commit.
STAGED_ENV=$(git diff --cached --name-only 2>/dev/null \
  | grep -E '(^|/)\.env(rc|$|\.)' \
  | grep -v '\.example$' \
  | grep -v '\.sample$' \
  || true)

if [ -n "$STAGED_ENV" ]; then
  echo "" >&2
  echo "ERROR: Staged files include credential files:" >&2
  echo "$STAGED_ENV" | while IFS= read -r f; do echo "  $f" >&2; done
  echo "" >&2
  echo "These files must not be committed. Add them to .gitignore:" >&2
  echo "  echo '.env' >> .gitignore" >&2
  echo "  echo '.envrc' >> .gitignore" >&2
  echo "" >&2
  exit 1
fi

# ── Gate 3: Run lint-staged (from commit root for correct GIT_INDEX_FILE) ────
COMMIT_ROOT="$(git rev-parse --show-toplevel)"
cd "$COMMIT_ROOT" && pnpm exec lint-staged
